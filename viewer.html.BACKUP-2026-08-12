<script>
// ------- State -------
const DATA = window.__DATA__;
const state = {
    q: '',
    typ: null,       // null = alle
    onlyCoords: false,
    hideSubunits: true,
    onlyBigUnis: false,
    onlyTU9: false,
    onlyExz: false,
    onlyU15: false,
    onlyRanked: false,
    qsMax: null,
    sortBy: 'qs',
};

// Subunit-Heuristik: enthält typische Fakultäts-Keywords
const SUBUNIT_RE = /\b(Fakultät|Fachbereich|Institut|Lehrstuhl|Department|Zentrum|Klinik|Abteilung|Fachrichtung)\b/i;

// ------- Karte initialisieren -------
let map, markerLayer;
try {
    if (typeof L === 'undefined') throw new Error('Leaflet not loaded');
    map = L.map('map', {
        center: [51.1, 10.3],  // Mitte Deutschland
        zoom: 6,
        zoomControl: true,
        preferCanvas: true,
    });
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap',
        maxZoom: 18,
    }).addTo(map);
    markerLayer = L.layerGroup().addTo(map);
} catch (e) {
    console.error(e);
    document.getElementById('mapErr').style.display = 'block';
}

// ------- Filter-Logik -------
function applyFilters() {
    let list = DATA.slice();

    if (state.q) {
        const q = state.q.toLowerCase();
        list = list.filter(r =>
            (r.name_de && r.name_de.toLowerCase().includes(q)) ||
            (r.name_en && r.name_en.toLowerCase().includes(q)) ||
            (r.name_kurz && r.name_kurz.toLowerCase().includes(q)) ||
            (r.stadt && r.stadt.toLowerCase().includes(q))
        );
    }
    if (state.typ) list = list.filter(r => r.typ === state.typ);
    if (state.onlyCoords) list = list.filter(r => r.latitude != null);
    if (state.hideSubunits) list = list.filter(r => !SUBUNIT_RE.test(r.name_de || ''));
    if (state.onlyBigUnis) list = list.filter(r => (r.studenten_anzahl || 0) >= 5000);
    if (state.onlyTU9) list = list.filter(r => r.tu9 === 1);
    if (state.onlyExz) list = list.filter(r => r.exzellenz === 1);
    if (state.onlyU15) list = list.filter(r => r.u15 === 1 || r.exzellenz === 1 || r.tu9 === 1);
    if (state.onlyRanked) list = list.filter(r => r.qs_2025 != null);
    if (state.qsMax != null) list = list.filter(r => r.qs_2025 != null && r.qs_2025 <= state.qsMax);

    // Sort
    list.sort((a, b) => {
        switch (state.sortBy) {
            case 'qs':       return (a.qs_2025 || 99999) - (b.qs_2025 || 99999);
            case 'students': return (b.studenten_anzahl || 0) - (a.studenten_anzahl || 0);
            case 'founded':  return (a.gruendungsjahr || 9999) - (b.gruendungsjahr || 9999);
            case 'city':     return (a.stadt || 'zzz').localeCompare(b.stadt || 'zzz', 'de');
            default:         return (a.name_de || '').localeCompare(b.name_de || '', 'de');
        }
    });

    render(list);
}

// ------- Render -------
function render(list) {
    document.getElementById('statShown').textContent = list.length;

    // Marker
    if (markerLayer) {
        markerLayer.clearLayers();
        for (const r of list) {
            if (r.latitude == null || r.longitude == null) continue;
            const color = typColor(r.typ);
            const m = L.circleMarker([r.latitude, r.longitude], {
                radius: 6, fillColor: color, color: '#fff',
                weight: 1.5, opacity: 1, fillOpacity: 0.85,
            });
            m.bindPopup(popupHtml(r) + '<div style="margin-top:8px;"><a href="#" onclick="event.preventDefault();window.__openDetail(' + r.id + ');" style="color:#5aa9ff;font-size:12px;">查看专业列表 →</a></div>');
            m.on('click', () => {
                const el = document.getElementById('row-' + r.id);
                if (el) {
                    document.querySelectorAll('.uni-row').forEach(x => x.classList.remove('active'));
                    el.classList.add('active');
                    el.scrollIntoView({ block: 'nearest' });
                }
            });
            m.addTo(markerLayer);
        }
    }

    // Liste
    const container = document.getElementById('uniList');
    container.innerHTML = list.map(r => {
        const labels = [];
        if (r.tu9) labels.push('<span class="label label-tu9">TU9</span>');
        if (r.exzellenz) labels.push('<span class="label label-exz">精英</span>');
        if (r.u15 && !r.exzellenz && !r.tu9) labels.push('<span class="label label-u15">U15</span>');
        const studyBadge = r.studiengang_count > 0
            ? '<span class="study-count-badge">' + r.studiengang_count + ' 专业</span>'
            : '';
        return `
        <div class="uni-row" id="row-${r.id}" data-id="${r.id}">
            <div class="name">
                ${escapeHtml(r.name_de)}
                ${labels.join('')}
                ${studyBadge}
            </div>
            <div class="meta">
                <span class="badge badge-${r.typ}">${r.typ}</span>
                <span>${r.stadt ? escapeHtml(r.stadt) : '<span class="no-coords">?</span>'}</span>
                ${r.qs_2025 ? '<span class="qs-rank">QS #' + r.qs_2025 + '</span>' : ''}
                ${r.studenten_anzahl ? '<span>' + r.studenten_anzahl.toLocaleString('de-DE') + ' 学生</span>' : ''}
                ${r.gruendungsjahr ? '<span>建校 ' + r.gruendungsjahr + '</span>' : ''}
                ${r.latitude == null ? '<span class="no-coords">无坐标</span>' : ''}
            </div>
        </div>`;
    }).join('');

    // Click auf Zeile → Detail-Ansicht öffnen
    container.querySelectorAll('.uni-row').forEach(el => {
        el.addEventListener('click', () => {
            const id = parseInt(el.dataset.id, 10);
            const r = DATA.find(x => x.id === id);
            openDetail(r);
        });
    });
}

// ------- Detail-Ansicht -------
const STUDIES = window.__STUDIES__;
const detailState = { uniId: null, q: '', abschluss: null };

// Abschluss-Gruppen: DE-Abschluss → chinesisches Label + Sortier-Prio
const ABSCHLUSS_GROUPS = [
    { key: 'Bachelor',     zh: '本科',   prio: 1 },
    { key: 'Master',       zh: '硕士',   prio: 2 },
    { key: 'PhD',          zh: '博士',   prio: 3 },
    { key: 'Staatsexamen', zh: '国考',   prio: 4 },
    { key: 'Lehramt',      zh: '教师',   prio: 5 },
    { key: 'Diplom',       zh: 'Diplom', prio: 6 },
    { key: 'Magister',     zh: 'Magister', prio: 7 },
    { key: 'Zertifikat',   zh: '证书',   prio: 8 },
    { key: 'Sonstige',     zh: '其他',   prio: 9 },
];
const ABSCHLUSS_ZH = Object.fromEntries(ABSCHLUSS_GROUPS.map(g => [g.key, g.zh]));
const ABSCHLUSS_PRIO = Object.fromEntries(ABSCHLUSS_GROUPS.map(g => [g.key, g.prio]));

// Fach-Name normalisieren für Grouping
// Entfernt Zusätze wie "(Hauptfach)", "120 ECTS", "Nebenfach" etc.
function normalizeSubjectName(name) {
    return name
        .replace(/\s*[-–]\s*(Hauptfach|Nebenfach|Kernfach|Erweiterungsfach|Beifach|Ergänzungsfach|60 ECTS|120 ECTS|30 ECTS|90 ECTS)\b.*/gi, '')
        .replace(/\s*\(.*?\)\s*/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
}

function openDetail(uni) {
    detailState.uniId = uni.id;
    detailState.q = '';
    detailState.abschluss = null;

    document.getElementById('listView').style.display = 'none';
    document.getElementById('detailView').style.display = 'block';

    document.getElementById('detailTitle').textContent = uni.name_de;
    const parts = [];
    if (uni.stadt) parts.push(uni.stadt);
    if (uni.qs_2025) parts.push('QS #' + uni.qs_2025);
    if (uni.tu9) parts.push('TU9');
    if (uni.exzellenz) parts.push('精英大学');

    // Dedupe zählen
    const uniStudies = STUDIES.filter(s => s.hochschule_id === uni.id);
    const uniqueSubjects = new Set(uniStudies.map(s => normalizeSubjectName(s.name_de)));
    parts.push(uniqueSubjects.size + ' 个专业方向');
    document.getElementById('detailSubtitle').textContent = parts.join(' · ');

    document.getElementById('studyQ').value = '';

    if (map && uni.latitude != null) {
        map.setView([uni.latitude, uni.longitude], 13, { animate: true });
    }

    // Abschluss-Chips (nur die vorhandenen, Reihenfolge nach Prio)
    const counts = {};
    for (const s of uniStudies) counts[s.abschluss] = (counts[s.abschluss] || 0) + 1;
    const chipList = ABSCHLUSS_GROUPS
        .filter(g => counts[g.key])
        .sort((a, b) => a.prio - b.prio);
    const chipsEl = document.getElementById('abschlussChips');
    chipsEl.innerHTML = chipList
        .map(g => `<div class="chip" data-abs="${g.key}">${g.zh} (${counts[g.key]})</div>`)
        .join('');
    chipsEl.querySelectorAll('.chip').forEach(el => {
        el.addEventListener('click', () => {
            const a = el.dataset.abs;
            if (detailState.abschluss === a) { detailState.abschluss = null; el.classList.remove('active'); }
            else {
                detailState.abschluss = a;
                chipsEl.querySelectorAll('.chip').forEach(x => x.classList.remove('active'));
                el.classList.add('active');
            }
            renderStudies();
        });
    });

    renderStudies();
}

function renderStudies() {
    const uniStudies = STUDIES.filter(s => s.hochschule_id === detailState.uniId);

    // Gruppe nach normalisiertem Fachnamen
    const groups = new Map();  // key = normalized name, value = { name, entries: [...] }
    for (const s of uniStudies) {
        const key = normalizeSubjectName(s.name_de);
        if (!groups.has(key)) groups.set(key, { name: key, entries: [] });
        groups.get(key).entries.push(s);
    }

    let arr = [...groups.values()];

    // Filter Suche
    if (detailState.q) {
        const q = detailState.q.toLowerCase();
        arr = arr.filter(g =>
            g.name.toLowerCase().includes(q) ||
            g.entries.some(e => e.name_de.toLowerCase().includes(q))
        );
    }
    // Filter Abschluss
    if (detailState.abschluss) {
        arr = arr.filter(g => g.entries.some(e => e.abschluss === detailState.abschluss));
    }

    // Sort: A-Z
    arr.sort((a, b) => a.name.localeCompare(b.name, 'de'));

    const el = document.getElementById('studyList');
    if (arr.length === 0) {
        el.innerHTML = uniStudies.length === 0
            ? '<div class="no-studies-hint">这所学校的专业数据还没爬取。<br>目前只有 LMU 的完整专业列表。</div>'
            : '<div class="no-studies-hint">没有匹配的专业</div>';
        return;
    }

    el.innerHTML = arr.map((g, idx) => {
        const seen = new Set();
        const uniqueEntries = g.entries
            .slice()
            .sort((a, b) => (ABSCHLUSS_PRIO[a.abschluss] || 99) - (ABSCHLUSS_PRIO[b.abschluss] || 99))
            .filter(e => {
                const k = e.abschluss + '|' + e.url;
                if (seen.has(k)) return false;
                seen.add(k);
                return true;
            });
        const tags = uniqueEntries
            .map(e => `<a href="${escapeHtml(e.url || '#')}" target="_blank" rel="noopener" class="abschluss-tag abs-${e.abschluss}" title="${escapeHtml(e.name_de)}">${ABSCHLUSS_ZH[e.abschluss] || e.abschluss}<span class="arrow">↗</span></a>`)
            .join('');
        // Facts nur wenn welche vorhanden
        const hasFacts = uniqueEntries.some(e =>
            e.regelstudienzeit || e.ects || e.studiengebuehr_non_eu ||
            e.deadline_ws || e.deadline_ss || e.zulassungsart ||
            e.sprachnachweis_details || e.bewerbungs_url
        );
        const rowId = 'study-' + idx;
        const expandBtn = hasFacts
            ? `<button class="expand-btn" data-expand="${rowId}">详情 ▾</button>`
            : '';

        const factsHtml = hasFacts ? uniqueEntries.map(e => {
            const rows = [];
            const lang = e.sprache === 'en' ? '英语' : e.sprache === 'de/en' ? '德/英' : e.sprache === 'de' ? '德语' : null;
            if (lang) rows.push(['授课语言', lang]);
            if (e.regelstudienzeit) rows.push(['学制', e.regelstudienzeit + ' 学期']);
            if (e.ects) rows.push(['ECTS', e.ects]);
            if (e.studiengebuehr_non_eu) rows.push(['学费(非欧盟)', e.studiengebuehr_non_eu.toLocaleString('de-DE') + ' € / 学期']);
            if (e.zulassungsart) {
                const zh = { 'NC': 'NC 分数线', 'Eignung': 'Eignungsverfahren (适性检核)', 'zulassungsfrei': '免申请（直接注册）', 'Portfolio': '作品集', 'Test': '入学考试' }[e.zulassungsart] || e.zulassungsart;
                rows.push(['录取方式', zh + (e.eignungsverfahren ? ' <span class="eig-warn">需要 Eignung</span>' : '')]);
            }
            if (e.deadline_ws) rows.push(['冬季学期截止', escapeHtml(e.deadline_ws)]);
            if (e.deadline_ss) rows.push(['夏季学期截止', escapeHtml(e.deadline_ss)]);
            if (e.sprachnachweis_details) rows.push(['语言证书', escapeHtml(e.sprachnachweis_details.slice(0, 200)) + (e.sprachnachweis_details.length > 200 ? '…' : '')]);

            const rowsHtml = rows.map(([label, val]) =>
                `<div class="fact-row"><span class="fact-label">${label}</span><span class="fact-value">${val}</span></div>`
            ).join('');
            const applyUrl = e.bewerbungs_url || e.url;
            return `
                <div style="margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px dashed #333844;">
                    <div style="color: #8ec5ff; font-weight: 600; margin-bottom: 6px;">${ABSCHLUSS_ZH[e.abschluss] || e.abschluss}</div>
                    ${rowsHtml}
                    <div style="margin-top: 8px;">
                        <a href="${escapeHtml(e.url)}" target="_blank" rel="noopener" class="apply-cta" style="background: #262b36; margin-right: 4px;">专业介绍 ↗</a>
                        ${applyUrl && applyUrl !== e.url ? `<a href="${escapeHtml(applyUrl)}" target="_blank" rel="noopener" class="apply-cta">去申请 ↗</a>` : ''}
                    </div>
                </div>`;
        }).join('') : '';

        return `
            <div class="study-row">
                <div class="study-name">
                    ${escapeHtml(g.name)}
                    ${expandBtn}
                </div>
                <div class="abschluss-list">${tags}</div>
                <div class="study-facts" id="${rowId}">${factsHtml}</div>
            </div>`;
    }).join('');

    // Expand buttons
    el.querySelectorAll('.expand-btn').forEach(btn => {
        btn.addEventListener('click', e => {
            e.stopPropagation();
            const id = btn.dataset.expand;
            const card = document.getElementById(id);
            const isOpen = card.classList.toggle('open');
            btn.textContent = isOpen ? '详情 ▴' : '详情 ▾';
        });
    });
}

function closeDetail() {
    document.getElementById('listView').style.display = 'block';
    document.getElementById('detailView').style.display = 'none';
}
document.getElementById('backBtn').addEventListener('click', closeDetail);
document.getElementById('studyQ').addEventListener('input', e => {
    detailState.q = e.target.value.trim();
    renderStudies();
});

// Für Popup-Link
window.__openDetail = (id) => {
    const uni = DATA.find(x => x.id === id);
    if (uni) openDetail(uni);
};

function typColor(t) {
    return ({
        'Universität': '#5aa9ff',
        'TU': '#ff9d5a',
        'FH': '#5affac',
        'Musik': '#ff7ecd',
        'Kunst': '#c88fff',
        'PH': '#ffd766',
        'Sonstige': '#8a92a3',
    })[t] || '#8a92a3';
}

function popupHtml(r) {
    const labels = [];
    if (r.tu9) labels.push('<span class="label label-tu9">TU9</span>');
    if (r.exzellenz) labels.push('<span class="label label-exz">精英</span>');
    if (r.u15 && !r.exzellenz && !r.tu9) labels.push('<span class="label label-u15">U15</span>');
    const rankings = [];
    if (r.qs_2025) rankings.push('QS #' + r.qs_2025);
    if (r.the_2025) rankings.push('THE #' + r.the_2025);
    if (r.arwu_2024) rankings.push('ARWU #' + r.arwu_2024);
    return `
        <h3>${escapeHtml(r.name_de)}</h3>
        <div style="margin-bottom: 6px;">
            <span class="badge badge-${r.typ}" style="background: ${typColor(r.typ)}; color: #0f1115;">${r.typ}</span>
            ${labels.join(' ')}
        </div>
        ${rankings.length ? '<div style="margin: 6px 0; font-size: 12px; color: #8ec5ff;">🏆 ' + rankings.join(' · ') + '</div>' : ''}
        ${r.stadt ? '<div>📍 ' + escapeHtml(r.stadt) + '</div>' : ''}
        ${r.studenten_anzahl ? '<div>👥 ' + r.studenten_anzahl.toLocaleString('de-DE') + ' 学生</div>' : ''}
        ${r.gruendungsjahr ? '<div>📅 建校 ' + r.gruendungsjahr + '</div>' : ''}
        ${r.website ? '<div><a href="' + r.website + '" target="_blank" rel="noopener">官网 ↗</a></div>' : ''}
        ${r.wikidata_qid ? '<div style="font-size:11px;color:#8a92a3;margin-top:4px;">Wikidata: ' + r.wikidata_qid + '</div>' : ''}
    `;
}

function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    })[c]);
}

// ------- UI Setup -------
// Typ-Chips
const TYPS = ['Universität', 'TU', 'FH', 'Musik', 'Kunst', 'PH', 'Sonstige'];
const chipContainer = document.getElementById('typChips');
chipContainer.innerHTML = TYPS.map(t => `<div class="chip" data-typ="${t}">${t}</div>`).join('');
chipContainer.querySelectorAll('.chip').forEach(el => {
    el.addEventListener('click', () => {
        const t = el.dataset.typ;
        if (state.typ === t) { state.typ = null; el.classList.remove('active'); }
        else {
            state.typ = t;
            chipContainer.querySelectorAll('.chip').forEach(x => x.classList.remove('active'));
            el.classList.add('active');
        }
        applyFilters();
    });
});

document.getElementById('q').addEventListener('input', e => { state.q = e.target.value.trim(); applyFilters(); });
document.getElementById('onlyCoords').addEventListener('change', e => { state.onlyCoords = e.target.checked; applyFilters(); });
document.getElementById('hideSubunits').addEventListener('change', e => { state.hideSubunits = e.target.checked; applyFilters(); });
document.getElementById('onlyBigUnis').addEventListener('change', e => { state.onlyBigUnis = e.target.checked; applyFilters(); });
document.getElementById('onlyTU9').addEventListener('change', e => { state.onlyTU9 = e.target.checked; applyFilters(); });
document.getElementById('onlyExz').addEventListener('change', e => { state.onlyExz = e.target.checked; applyFilters(); });
document.getElementById('onlyU15').addEventListener('change', e => { state.onlyU15 = e.target.checked; applyFilters(); });
document.getElementById('onlyRanked').addEventListener('change', e => { state.onlyRanked = e.target.checked; applyFilters(); });
document.getElementById('qsMax').addEventListener('input', e => {
    const v = parseInt(e.target.value, 10);
    state.qsMax = Number.isFinite(v) && v > 0 ? v : null;
    applyFilters();
});
document.getElementById('sortBy').addEventListener('change', e => { state.sortBy = e.target.value; applyFilters(); });
document.getElementById('reset').addEventListener('click', () => {
    Object.assign(state, {
        q: '', typ: null, onlyCoords: false, hideSubunits: true, onlyBigUnis: false,
        onlyTU9: false, onlyExz: false, onlyU15: false, onlyRanked: false, qsMax: null,
        sortBy: 'qs',
    });
    document.getElementById('q').value = '';
    for (const id of ['onlyCoords','onlyBigUnis','onlyTU9','onlyExz','onlyU15','onlyRanked']) {
        document.getElementById(id).checked = false;
    }
    document.getElementById('hideSubunits').checked = true;
    document.getElementById('qsMax').value = '';
    document.getElementById('sortBy').value = 'qs';
    chipContainer.querySelectorAll('.chip').forEach(x => x.classList.remove('active'));
    applyFilters();
});

// Initial render
applyFilters();
</script>

